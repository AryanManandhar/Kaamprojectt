# Copy this file to .env and fill in your real values.
# Never commit the real .env file to git.

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=kam_app
DB_PORT=3306
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Used to sign login session tokens — make this a long random string in production
JWT_SECRET=change_this_to_a_long_random_string

# Port the API server runs on
PORT=4000

# Password to log into the admin panel (http://localhost:8080)
ADMIN_PASSWORD=choose_something_only_you_know

# Port the admin panel server runs on (optional, defaults to 8080 if omitted)
ADMIN_PORT=8080

# mailer.js reads these directly (SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASS/MAIL_FROM).
# For Gmail: SMTP_PASS must be a Gmail "App Password", not your normal password
# (Google Account > Security > 2-Step Verification > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM="Kam <you@gmail.com>"

BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5500/kam-app.html

# eSewa test credentials (these are eSewa's own published sandbox values —
# safe to use for development, everyone uses the same ones)
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q

# Khalti test credentials — get your own free test key at
# https://test-admin.khalti.com (Settings > Keys)
KHALTI_SECRET_KEY=your_test_secret_key
